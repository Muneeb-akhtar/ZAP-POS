# Copy this file to .env.local and fill in your Supabase project values
# (Supabase → Project Settings → API). Also add both to Vercel → Settings → Environment Variables.
# The anon key is meant to be public; security comes from Row Level Security (see supabase/schema.sql).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
