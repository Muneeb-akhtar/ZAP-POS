  "faq": {
    "kicker": "FAQ",
    "title": "Questions shopkeepers",
    "titleHighlight": "ask us on WhatsApp.",
    "description": "Tap a question. Still stuck? Message us, a real person replies.",
    "items": [
      {
        "q": "Does ZAP POS work without internet?",
        "a": "Yes. Billing, printing and stock updates all work offline. Sales are saved on the counter PC and sync to the cloud automatically when the internet returns."
      },
      {
        "q": "What hardware do I need?",
        "a": "Any Windows 10 or 11 PC. ZAP POS supports standard thermal receipt printers, USB barcode scanners, cash drawers and label printers."
      },
      {
        "q": "Can I import my existing products?",
        "a": "Yes. Import your product list from Excel, or scan barcodes to add products one by one."
      },
      {
        "q": "Can I run more than one counter in a shop?",
        "a": "Yes. On the Brand and Enterprise plans, add as many counters as you need. They share stock and prices over your local network."
      },
      {
        "q": "Is there a free trial?",
        "a": "Yes. Every plan comes with a free trial and no card is required."
      }
    ]
